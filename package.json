{
  "name": "@dorbs/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip && pnpm rust",
    "e2e": "HARNESS=pi node scripts/e2e.ts && HARNESS=opencode node scripts/e2e.ts",
    "live": "node scripts/live.ts",
    "chatgpt-login": "node scripts/chatgpt-login.ts",
    "load": "node scripts/load.ts",
    "bench": "node scripts/bench.ts",
    "compare": "node scripts/compare.ts",
    "soak": "node scripts/soak.ts",
    "hillclimb": "node scripts/hillclimb/run.ts",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "knip": "knip",
    "lint": "vp lint --deny-warnings --report-unused-disable-directives",
    "test": "vp run -r test",
    "typecheck": "vp run -r typecheck && tsrs --noEmit -p scripts",
    "verify-gates": "bash scripts/verify-gates.sh",
    "rust": "cargo fmt --check && cargo clippy --all-targets --locked -- -D warnings && cargo test --locked"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "tsrs": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.12.1"
  },
  "packageManager": "pnpm@12.15.0"
}
