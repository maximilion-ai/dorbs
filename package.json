{
  "name": "@dorbs/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "knip": "knip",
    "lint": "vp lint --deny-warnings --report-unused-disable-directives",
    "test": "vp run -r test",
    "typecheck": "vp run -r typecheck",
    "verify-gates": "bash scripts/verify-gates.sh"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "knip": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.12.1"
  },
  "packageManager": "pnpm@12.15.0"
}
